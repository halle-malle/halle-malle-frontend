rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHost() {
      return resource.data.hostId == request.auth.uid;
    }

    function changesOnlyOwnMembership() {
      let fields = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.memberIds.toSet();
      let after = request.resource.data.memberIds.toSet();
      let added = after.difference(before);
      let removed = before.difference(after);
      return fields.hasOnly(['memberIds', 'memberCount', 'status'])
        && request.resource.data.memberIds.size() == after.size()
        && request.resource.data.memberCount == after.size()
        && ((added == [request.auth.uid].toSet() && removed.size() == 0
              && resource.data.status == 0
              && after.size() <= resource.data.maxMember
              && (request.resource.data.status == 0
                  || (request.resource.data.status == 1
                      && after.size() == resource.data.maxMember)))
            || (removed == [request.auth.uid].toSet() && added.size() == 0
                && resource.data.status == 0
                && request.resource.data.status == 0));
    }

    // 방장 강퇴 : 방장이 자기 말고 다른 멤버 1명만 빼고, 인원 수도 맞게 줄이는 경우
    function hostRemovesOneMember() {
      let fields = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.memberIds.toSet();
      let after = request.resource.data.memberIds.toSet();
      let removed = before.difference(after);
      return fields.hasOnly(['memberIds', 'memberCount'])
        && request.resource.data.memberIds.size() == after.size()
        && request.resource.data.memberCount == after.size()
        && after.difference(before).size() == 0
        && removed.size() == 1
        && !removed.hasAny([resource.data.hostId]);
    }

    // Keep the existing access policy for unrelated app collections.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && collection != 'groups'
        && collection != 'notificationInboxes';
    }

    // Notification history and ballots are accessed through authenticated Functions.
    match /notificationInboxes/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.status == 0
        && !request.resource.data.keys().hasAny(['canceledByVote', 'cancelVoteUpdatedAt', 'cancelVoteRound', 'cancelApprovalCount']);
      allow delete: if false;
      allow update: if signedIn()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['hostId', 'canceledByVote', 'cancelVoteUpdatedAt', 'cancelVoteRound', 'cancelApprovalCount'])
        && resource.data.status != 2
        && request.resource.data.status != 2
        && (changesOnlyOwnMembership()
            || (isHost() && request.resource.data.memberIds == resource.data.memberIds)
            || (isHost() && hostRemovesOneMember()));
    }

    match /groups/{groupId}/members/{memberId} {
      allow read, create, update: if signedIn();
      // 본인 탈퇴 또는 방장 강퇴 (방장 자신의 멤버 문서는 삭제 불가)
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.hostId != memberId
        && (request.auth.uid == memberId
            || get(/databases/$(database)/documents/groups/$(groupId)).data.hostId == request.auth.uid);
    }

    match /groups/{groupId}/chats/{chatId} {
      allow read, create, update: if signedIn();
    }

    match /groups/{groupId}/cancelVotes/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId}/cancelVotes/{round}/ballots/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId}/{subcollection}/{document=**} {
      allow read, write: if signedIn()
        && !(subcollection in ['cancelVotes', 'members', 'chats']);
    }
  }
}
