<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/home">
    <fragment
        android:id="@+id/home"
        android:name= "com.do_it.homeFragment"
        android:label="할래말래?"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/quest"
        android:name="com.do_it.mapFragment"
        android:label="@string/title_quest"
        tools:layout="@layout/fragment_map" />
    <fragment
        android:id="@+id/my"
        android:name="com.do_it.mypageFragment"
        android:label="마이페이지"
        tools:layout="@layout/fragment_mypage" >
        <action
            android:id="@+id/action_my_to_friendFragment"
            app:destination="@id/friendFragment" />
        <action
            android:id="@+id/action_my_to_group_ManagementFragment"
            app:destination="@id/group_ManagementFragment" />
        <action
            android:id="@+id/action_my_to_previous_meetingFragment"
            app:destination="@id/previous_meetingFragment" />
        <action
            android:id="@+id/action_my_to_notification_SettingsFragment"
            app:destination="@id/notification_SettingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/friendFragment"
        android:name="com.do_it.FriendFragment"
        android:label="친구"
        tools:layout="@layout/fragment_friend" />
    <fragment
        android:id="@+id/group_ManagementFragment"
        android:name="com.do_it.Group_ManagementFragment"
        android:label="내가 연 모임 관리"
        tools:layout="@layout/fragment_group__management" />
    <fragment
        android:id="@+id/previous_meetingFragment"
        android:name="com.do_it.Previous_meetingFragment"
        android:label="지난 모임"
        tools:layout="@layout/fragment_previous_meeting" />
    <fragment
        android:id="@+id/notification_SettingsFragment"
        android:name="com.do_it.Notification_SettingsFragment"
        android:label="알림 설정"
        tools:layout="@layout/fragment_notification__settings" />
</navigation>