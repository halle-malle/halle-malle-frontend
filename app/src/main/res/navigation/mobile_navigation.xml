<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/home">
    <fragment
        android:id="@+id/home"
        android:name= "com.do_it.homeFragment"
        android:label=""
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/quest"
        android:name="com.do_it.mapFragment"
        android:label=""
        tools:layout="@layout/fragment_map" />
    <fragment
        android:id="@+id/my"
        android:name="com.do_it.mypageFragment"
        android:label=""
        tools:layout="@layout/fragment_mypage" >
        <action
            android:id="@+id/action_my_to_friendFragment"
            app:destination="@id/friendFragment" />
        <action
            android:id="@+id/action_my_to_previous_meetingFragment"
            app:destination="@id/previous_meetingFragment" />
        <action
            android:id="@+id/action_my_to_notification_SettingsFragment"
            app:destination="@id/notification_SettingsFragment" />
        <action
            android:id="@+id/action_my_to_privacyFragment"
            app:destination="@id/privacyFragment" />
        <action
            android:id="@+id/action_my_to_rulesFragment"
            app:destination="@id/rulesFragment" />
        <action
            android:id="@+id/action_my_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>
    <fragment
        android:id="@+id/friendFragment"
        android:name="com.do_it.FriendFragment"
        android:label=""
        tools:layout="@layout/fragment_friend" />
    <fragment
        android:id="@+id/previous_meetingFragment"
        android:name="com.do_it.Previous_meetingFragment"
        android:label=""
        tools:layout="@layout/fragment_previous_meeting" />
    <fragment
        android:id="@+id/notification_SettingsFragment"
        android:name="com.do_it.Notification_SettingsFragment"
        android:label=""
        tools:layout="@layout/fragment_notification__settings" />
    <fragment android:id="@+id/editProfileFragment" android:name="com.do_it.EditProfileFragment"
        android:label="" tools:layout="@layout/fragment_edit_profile" />
    <fragment
        android:id="@+id/rulesFragment"
        android:name="com.do_it.RulesFragment"
        android:label=""
        tools:layout="@layout/fragment_rules" />
    <fragment
        android:id="@+id/privacyFragment"
        android:name="com.do_it.PrivacyFragment"
        android:label=""
        tools:layout="@layout/fragment_privacy" />
</navigation>