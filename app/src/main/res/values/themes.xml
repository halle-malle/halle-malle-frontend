<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Hallemalle"  parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#4C722E</item>
        <item name="colorPrimaryVariant">#FBF8EF</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#4C722E</item>
        <item name="colorSecondaryVariant">#4C722E</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- 하단 탭 선택 배경 색 바꾸기 -->
        <item name="colorSecondaryContainer">#EEF4E6</item>
        <item name="colorOnSecondaryContainer">#3E6123</item>
        <item name="android:windowBackground">#FBF8EF</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <!-- 화면이 밝아서 보이지 않던 상태바 수정        -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppBottomSheetDialogBorder20WhiteTheme"
        parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalBorder20WhiteStyle</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="AppModalBorder20WhiteStyle"
        parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

</resources>