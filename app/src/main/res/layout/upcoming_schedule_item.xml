<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_card"
    >

    <!-- 상단: 시간/D-day + 뱃지 -->
    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="내일 17:00 · D-1"
            android:textSize="12sp" />

        <TextView
            android:background="@drawable/bg_status_card_white"
            android:id="@+id/tvConfirmed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"

            android:text="모임 확정"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/bg_status_card_black"
            android:id="@+id/tvJoined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="참여 중"
            android:textColor="@android:color/background_light"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 제목 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="배드민턴 할래? 🏸"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 일시 / 장소 -->
    <TextView
        android:id="@+id/tvPlace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="10.23 (금) 17:00  |  동양미래대학교 8호관 1층 대강당"
        android:textSize="12sp" />

    <!-- 멤버 / 공지 -->
    <TextView
        android:id="@+id/tvNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="멤버 4/10명 · 공지: 8호관 CU 편의점 앞에서 만나요"
        android:textSize="12sp" />

    <!-- 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:background="@drawable/bg_status_card_white"
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:text="💬 그룹 채팅 · 새 메시지 2"
            android:textSize="13sp" />

        <Button
            android:background="@drawable/bg_status_card_black"
            android:id="@+id/btnDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="모임 상세"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>