<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 로그인 화면 -->
    <LinearLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="64dp"
        android:paddingBottom="20dp">

        <!-- 앱 이름 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="할래말래?"
            android:textColor="#666666"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 로그인 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="로그인"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="휴대폰 번호로 간편하게 시작하세요."
            android:textColor="#888888"
            android:textSize="12sp" />

        <!-- 휴대폰 번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="휴대폰 번호"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editLoginPhone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="휴대폰 번호를 입력해주세요."
                android:inputType="phone"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#222222"
                android:textColorHint="#BBBBBB"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_site"
                android:backgroundTint="@null"
                android:text="인증 요청"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 인증번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="인증번호"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLoginCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="인증번호 6자리를 입력해주세요."
            android:inputType="number"
            android:maxLength="6"
            android:maxLines="1"
            android:enabled="false"
            android:saveEnabled="false"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#BBBBBB"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/textVerificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="인증번호를 입력해주세요."
            android:textColor="#888888"
            android:textSize="12sp" />
        <Button
            android:id="@+id/buttonConfirmLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_button"
            android:backgroundTint="@null"
            android:text="로그인"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="계속하면 이용약관과 개인정보 처리방침에 동의하게 돼요."
            android:textColor="#BBBBBB"
            android:textSize="10sp" />

    </LinearLayout>


    <!-- 최초 프로필 등록 화면 -->
    <ScrollView
        android:id="@+id/layoutProfile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- 상단 메뉴 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonBackLogin"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="←"
                    android:textColor="#222222"
                    android:textSize="24sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="프로필 등록"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="40dp"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- 제목 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="프로필을 만들어주세요."
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="나를 소개할 프로필을 등록하고 시작해요."
                android:textColor="#888888"
                android:textSize="12sp" />

            <!-- 프로필 사진 -->
            <ImageView
                android:id="@+id/imageProfile"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_input"
                android:clipToOutline="true"
                android:src="@android:drawable/ic_menu_camera"
                android:scaleType="centerCrop"
                android:contentDescription="프로필 사진" />

            <!-- 사진 선택 -->
            <Button
                android:id="@+id/buttonSelectImage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_site"
                android:backgroundTint="@null"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="프로필 사진 선택"
                android:textSize="12sp" />

            <!-- 이름 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="이름"
                android:textColor="#222222"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editProfileName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="이름을 입력해주세요."
                android:inputType="textPersonName"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#222222"
                android:textColorHint="#BBBBBB"
                android:textSize="13sp" />

            <!-- 닉네임 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="닉네임"
                android:textColor="#222222"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editProfileNickname"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="닉네임을 입력해주세요."
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#222222"
                android:textColorHint="#BBBBBB"
                android:textSize="13sp" />

            <!-- 한 줄 소개 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="한 줄 소개"
                android:textColor="#222222"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editProfileBio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="나를 간단하게 소개해주세요."
                android:inputType="text"
                android:maxLines="1"
                android:maxLength="100"
                android:padding="12dp"
                android:textColor="#222222"
                android:textColorHint="#BBBBBB"
                android:textSize="13sp" />

            <!-- 프로필 등록 완료 -->
            <Button
                android:id="@+id/buttonSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_login_button"
                android:backgroundTint="@null"
                android:text="시작하기"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>


    <!-- 로그인 완료 화면 : 교수님 기존 구조 유지 -->
    <LinearLayout
        android:id="@+id/layoutHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인 성공"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textUserPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/gray"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="로그아웃" />

    </LinearLayout>

</FrameLayout>