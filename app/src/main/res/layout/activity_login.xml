<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/main">


    <!-- 로그인 화면 -->
    <LinearLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="64dp"
        android:paddingBottom="20dp">

        <!-- 앱 이름 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="할래말래?"
            android:textColor="#666666"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 로그인 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="로그인"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 안내 문구 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="이메일이나 Google 계정으로 시작하세요."
            android:textColor="#888888"
            android:textSize="12sp" />

        <!-- 이메일 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="이메일"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 이메일 입력 -->
        <EditText
            android:id="@+id/editLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="이메일을 입력해주세요"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

        <!-- 비밀번호 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="비밀번호"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 비밀번호 입력 -->
        <EditText
            android:id="@+id/editLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="비밀번호를 입력해주세요"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

        <!-- 로그인 버튼 -->
        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_button"
            android:backgroundTint="@null"
            android:text="로그인"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 비밀번호 찾기 / 회원가입 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonFindPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:text="비밀번호 찾기"
                android:textAllCaps="false"
                android:textColor="#666666"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="#DDDDDD" />

            <Button
                android:id="@+id/buttonGoSignup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:text="회원가입"
                android:textAllCaps="false"
                android:textColor="#222222"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 또는 구분선 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#EEEEEE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="또는"
                android:textColor="#BBBBBB"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#EEEEEE" />

        </LinearLayout>

        <!-- 구글 로그인 버튼 -->
        <LinearLayout
            android:id="@+id/buttonGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_google_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <!-- 구글 로고 -->
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/google"
                android:contentDescription="Google 로고" />

            <!-- 버튼 글자 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Google로 가입하기"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- 아래 여백 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 하단 안내 문구 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="계속하면 이용약관과 개인정보 처리방침에 동의하게 돼요."
            android:textColor="#BBBBBB"
            android:textSize="10sp" />

    </LinearLayout>



    <!-- 회원가입 화면 -->
    <LinearLayout
        android:id="@+id/layoutSignup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <!-- 상단 메뉴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonBackLogin"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="←"
                android:textColor="#222222"
                android:textSize="24sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="회원가입"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="40dp"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="이메일로 가입하기"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 설명 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="가입 후 닉네임과 프로필을 등록해요."
            android:textColor="#888888"
            android:textSize="12sp" />

        <!-- 이메일 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="이메일"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editSignupEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="이메일을 입력해주세요"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#BBBBBB"
            android:textSize="13sp" />

        <!-- 비밀번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="비밀번호"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editSignupPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="비밀번호를 입력해주세요"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#BBBBBB"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="영문과 숫자를 포함해 8자 이상 입력해주세요."
            android:textColor="#888888"
            android:textSize="11sp" />

        <!-- 비밀번호 확인 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="비밀번호 확인"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editSignupPasswordConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="비밀번호를 한 번 더 입력해주세요"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#BBBBBB"
            android:textSize="13sp" />

        <!-- 회원가입 버튼 -->
        <Button
            android:id="@+id/buttonSignup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_button"
            android:backgroundTint="@null"
            android:text="가입하기"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 로그인 화면 이동 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이미 계정이 있나요?"
                android:textColor="#777777"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/buttonSignupToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="로그인"
                android:textColor="#222222"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 또는 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#EEEEEE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="또는"
                android:textColor="#BBBBBB"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#EEEEEE" />
        </LinearLayout>

        <!-- Google 회원가입 -->

        <!-- 구글 회원가입 버튼 -->
        <LinearLayout
            android:id="@+id/buttonGoogleSignup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_google_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <!-- 구글 로고 -->
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/google"
                android:contentDescription="Google 로고" />

            <!-- 버튼 글자 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Google로 가입하기"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- 남은 공간 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 하단 안내 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="가입하면 이용약관과 개인정보 처리방침에 동의하게 돼요."
            android:textColor="#BBBBBB"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- 비밀번호 찾기 화면 -->
    <LinearLayout
        android:id="@+id/layoutFindPassword"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp"
        android:visibility="gone">

        <!-- 상단 메뉴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonFindBack"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="←"
                android:textColor="#222222"
                android:textSize="24sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="비밀번호 찾기"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="40dp"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="비밀번호를 잊으셨나요?"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 설명 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="가입한 이메일로 재설정 링크를 보내드려요."
            android:textColor="#888888"
            android:textSize="12sp" />

        <!-- 이메일 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="이메일"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editFindEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="이메일을 입력해주세요"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#BBBBBB"
            android:textSize="13sp" />

        <!-- 안내 문구 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Google로 가입했다면 Google 로그인을 이용해주세요."
            android:textColor="#888888"
            android:textSize="11sp" />

        <!-- 비밀번호 재설정 버튼 -->
        <Button
            android:id="@+id/buttonResetPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_button"
            android:backgroundTint="@null"
            android:text="재설정 링크 보내기"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 로그인 화면 이동 -->
        <TextView
            android:id="@+id/buttonFindBackLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="로그인으로 돌아가기"
            android:textColor="#222222"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


    <!-- 로그인 완료 화면 -->
    <LinearLayout
        android:id="@+id/layoutHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인 성공"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/gray"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textProvider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/gray"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="로그아웃" />
    </LinearLayout>
</FrameLayout>
