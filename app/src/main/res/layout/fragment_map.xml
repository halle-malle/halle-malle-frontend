<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mapFragment">

    <!-- 지도 프래그먼트 -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        map:uiCompass="true"
        map:uiRotateGestures="true"
        map:uiScrollGestures="true"
        map:uiTiltGestures="true"
        map:uiZoomControls="true"
        map:uiZoomGestures="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 검색창 -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_box"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="17"
            android:layout_marginStart="15dp"
            android:background="@null"
            android:hint="어떤 모임을 찾으시나요?"
            android:inputType="text"
            android:textColor="#222222"
            android:textColorHint="#AEAEB2"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#555555" />
    </LinearLayout>

    <!-- 필터 -->
    <HorizontalScrollView
        android:id="@+id/scrollFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutSearch">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterSports"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="운동🏸"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterStudy"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="스터디💻"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterFood"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="맛집🍕"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterHobby"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="취미🎸"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterEtc"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="기타💬"
                android:textColor="@color/black"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 새로고침 버튼 -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/refresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_btn_circle"
        android:elevation="4dp"
        android:src="@android:drawable/ic_popup_sync"
        app:tint="#4A4A4A"
        android:scaleType="centerInside"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 모임 만들기 버튼 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/createMeeting"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_margin="21dp"
        android:background="@drawable/bg_btn_meeting"
        android:elevation="4dp"
        android:paddingHorizontal="18dp"
        android:text="+ 모임 만들기"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
