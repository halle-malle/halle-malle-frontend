<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PinBottomSheetFragment"
    >

    <LinearLayout
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="#CCCCCC" />

        <!-- 카테고리 / 모집 상태 / 날씨 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom = "15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginRight="7dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_input"
                android:textColor="#666666"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="운동" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_status_card_white"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="모집 중" />

            <TextView
                android:id="@+id/tvWeather"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#666666"
                android:textSize="13sp"
                android:text="맑음 24°C" />
        </LinearLayout>

        <!-- 모임 제목 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom = "15dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:text="🏸 대강당에서 배드민턴 할래?" />

        <!-- 방장 / 일시 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom = "15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="41dp"
                android:layout_height="45dp"
                android:layout_weight="0"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_avatar"
                app:srcCompat="@drawable/ic_person" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="홍길동 (방장)" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:text="2026.10.23 금요일 17:00" />
            </LinearLayout>
        </LinearLayout>

        <!-- 상세 설명 -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom = "15dp"
            android:textColor="#666666"
            android:textSize="14sp"
            android:text="시험도 끝났는데 배드민턴 쳐요! 왕초보 분들도 대환영입니다. 끝나고 뒤풀이도 갑시다!!" />

        <!-- 장소 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom = "15dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="#666666" />

            <TextView
                android:id="@+id/tvPlace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="15"
                android:text="동양미래대학교 8호관 1층 대강당"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 참여 멤버 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="참여 멤버" />

            <TextView
                android:id="@+id/tvMemberCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="15"
                android:textColor="#666666"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="3/10명" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_weight="0"
                android:background="@drawable/bg_avatar"
                app:srcCompat="@drawable/ic_person" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_weight="0"
                android:layout_marginLeft="2dp"
                android:background="@drawable/bg_avatar"
                app:srcCompat="@drawable/ic_person" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_weight="0"
                android:layout_marginLeft="2dp"
                android:background="@drawable/bg_avatar"
                app:srcCompat="@drawable/ic_person" />
        </LinearLayout>

        <!-- 참여하기 버튼 -->
        <Button
            android:id="@+id/btnJoin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#666666"
            app:cornerRadius="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="참여하기"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
